# Turso / libSQL
# Production: create a Turso database and paste its URL + auth token.
# Local development: leave TURSO_DATABASE_URL empty to use file:.data/local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Admin dashboard. Use a long random password in production.
ADMIN_PASSWORD=

# SSLCommerz (optional until you enable card/mobile-banking checkout)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_LIVE=false

# Public canonical URL, no trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000
